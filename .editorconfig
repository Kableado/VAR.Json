root = true

[*.]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
tab_width = 4
    trim_trailing_whitespace = true
    insert_final_newline = true
    max_line_length = 160

[*.cs]
# Using / imports
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true
csharp_using_directive_placement = outside_namespace:suggestion

# Prefer file-scoped namespace declarations (recommended)
csharp_style_namespace_declarations = file_scoped:suggestion

# Braces: opening brace on new line for types, methods, properties, control blocks (Allman style)
csharp_new_line_before_open_brace = all

# Allow simple embedded statements on a single line (e.g. if (x) { return; }) - codebase uses this form occasionally
csharp_style_allow_embedded_statements_on_same_line = true:suggestion

# Spaces: require a space after control-flow keywords (if/for/while/...) - matches observed spacing
csharp_space_after_keywords_in_control_flow_statements = true

# The codebase uses expression-bodied properties but prefers block-bodied methods.
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = false:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_indexers = false:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion

# var preferences: prefer explicit types everywhere. Use 'var' only for anonymous types.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# Prefer target-typed 'new' (e.g. MyType x = new(); ) when the type is apparent
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion

trailing_comma_in_multiline_lists = true
trailing_comma_in_singleline_lists = true
dotnet_diagnostic.SA1413.severity = warning

dotnet_style_prefer_collection_expression = true:suggestion

# Never recommend primary constructors
csharp_style_prefer_primary_constructors = false:none
dotnet_diagnostic.IDE0290.severity = none
dotnet_analyzer_diagnostic.IDE0290.severity = none
resharper_convert_to_primary_constructor_highlighting = none
resharper_replace_with_primary_constructor_parameter_highlighting = none

# Prefer explicit qualification with 'this.'? Not used in the codebase (keep it off)
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Naming: private fields use an underscore prefix (e.g. _port)
dotnet_naming_rule.private_fields_should_have_underscore_prefix.severity = suggestion
dotnet_naming_rule.private_fields_should_have_underscore_prefix.symbols = private_fields
dotnet_naming_rule.private_fields_should_have_underscore_prefix.style = underscore_prefix_style

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =

dotnet_naming_style.underscore_prefix_style.required_prefix = _
dotnet_naming_style.underscore_prefix_style.capitalization = camel_case
